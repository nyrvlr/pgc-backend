# Conexao pooled usada pela aplicacao
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Conexao direta usada pelo Prisma para migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

PORT=3000
CORS_ORIGIN="http://localhost:5173"

# Segredo para assinatura JWT — use um valor longo e aleatório em produção
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# ---------------------------------------------------------------------------
# Provisionamento de pesquisadora (apenas para npm run researcher:provision)
# Nunca commitar valores reais. Remover do ambiente após o provisionamento.
# ---------------------------------------------------------------------------
RESEARCHER_NAME="Nome da Pesquisadora"
RESEARCHER_EMAIL="email@instituicao.br"
RESEARCHER_PASSWORD="senha-temporaria-forte"
