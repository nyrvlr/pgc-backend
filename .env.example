# Conexao com o PostgreSQL (Neon).
# Use a connection string COM POOLING que o Neon fornece (termina em "-pooler").
# Exemplo: postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Porta do servidor HTTP/WebSocket
PORT=3000

# Origem permitida no CORS (o front). Em dev, o Vite costuma rodar em 5173.
CORS_ORIGIN="http://localhost:5173"
